<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.String?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="loginPane" managed="true" visible="true" xmlns="http://javafx.com/javafx/21.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.onlinemcqexam.LoginViewController">
    <styleClass>
        <String fx:value="root" />
        <String fx:value="login-root" />
    </styleClass>

    <VBox alignment="CENTER" spacing="18" styleClass="login-layout">
        <VBox alignment="CENTER" spacing="6">
            <Label text="Exam Portal">
                <styleClass>
                    <String fx:value="title" />
                    <String fx:value="login-app-title" />
                </styleClass>
            </Label>
        </VBox>

        <VBox alignment="CENTER" maxWidth="380" prefWidth="380" spacing="14" styleClass="card">
            <Label text="Online MCQ Exam">
                <styleClass>
                    <String fx:value="section-title" />
                    <String fx:value="login-subtitle" />
                </styleClass>
            </Label>
            <Label styleClass="muted" text="Log in to continue" />

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                <Label styleClass="field-label" text="USERNAME" />
                <TextField fx:id="loginUsername" maxWidth="Infinity" onAction="#handleLogin" promptText="Enter your student ID" />
            </VBox>

            <VBox alignment="CENTER_LEFT" maxWidth="Infinity" spacing="6">
                <Label styleClass="field-label" text="PASSWORD" />
                <PasswordField fx:id="loginPassword" maxWidth="Infinity" onAction="#handleLogin" />
            </VBox>

            <Button maxWidth="Infinity" onAction="#handleLogin" styleClass="primary-button" text="Log In" />

            <HBox alignment="CENTER" spacing="6">
                <Label styleClass="muted" text="New here?" />
                <Label onMouseClicked="#handleShowRegister" styleClass="link-highlight" text="Create Account" />
            </HBox>

            <Button maxWidth="Infinity" onAction="#handleShowTeacherLogin" text="Teacher Login">
                <styleClass>
                    <String fx:value="secondary-button" />
                    <String fx:value="teacher-login-button" />
                </styleClass>
            </Button>
            <Label fx:id="loginMessageLabel" styleClass="error-text" />
        </VBox>
    </VBox>
</StackPane>

