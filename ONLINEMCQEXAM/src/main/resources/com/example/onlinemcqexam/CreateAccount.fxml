<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="registerPane"
           xmlns="http://javafx.com/javafx/17.0.6"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.example.onlinemcqexam.ExamController"
           styleClass="root register-root">
    <children>
        <Region styleClass="register-ambient-glow"/>

        <HBox alignment="CENTER" spacing="44" styleClass="register-layout">
            <VBox prefWidth="360" maxWidth="420" spacing="20" styleClass="register-info-panel">
                <VBox spacing="8" styleClass="register-info-block">
                    <FontIcon iconLiteral="fas-shield-alt" styleClass="register-info-icon"/>
                    <Label text="Secure Assessment" styleClass="register-info-title"/>
                    <Label text="Encrypted student sessions and protected exam submissions keep every attempt reliable and safe."
                           styleClass="register-info-text" wrapText="true"/>
                </VBox>

                <VBox spacing="8" styleClass="register-info-block">
                    <FontIcon iconLiteral="fas-chart-line" styleClass="register-info-icon"/>
                    <Label text="Real-time Analytics" styleClass="register-info-title"/>
                    <Label text="Track exam progress, completion insights, and leaderboard movement the moment students finish."
                           styleClass="register-info-text" wrapText="true"/>
                </VBox>
            </VBox>

            <VBox prefWidth="430" maxWidth="430" spacing="16" styleClass="register-card">
                <StackPane prefWidth="54" prefHeight="54" styleClass="register-badge">
                    <FontIcon iconLiteral="fas-user-shield" styleClass="register-badge-icon"/>
                </StackPane>

                <VBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="Create Account" styleClass="register-title"/>
                    <Label text="Register to take exams" styleClass="register-subtitle"/>
                </VBox>

                <HBox fx:id="registerErrorBanner" spacing="8" alignment="CENTER_LEFT" styleClass="register-error-banner" visible="false" managed="false">
                    <FontIcon iconLiteral="fas-exclamation-triangle" styleClass="register-error-icon"/>
                    <Label fx:id="registerMessageLabel" styleClass="register-error-text" wrapText="true"/>
                </HBox>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="USERNAME / STUDENT ID" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-user" styleClass="register-field-icon"/>
                            <TextField fx:id="registerUsername"
                                       HBox.hgrow="ALWAYS"
                                       maxWidth="Infinity"
                                       promptText="Enter student ID"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="FULL NAME" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-id-card" styleClass="register-field-icon"/>
                            <TextField fx:id="registerFullName"
                                       HBox.hgrow="ALWAYS"
                                       maxWidth="Infinity"
                                       promptText="Enter full name"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="PASSWORD" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-lock" styleClass="register-field-icon"/>
                            <PasswordField fx:id="registerPassword"
                                           HBox.hgrow="ALWAYS"
                                           maxWidth="Infinity"
                                           promptText="Create password"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="CONFIRM PASSWORD" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-check-circle" styleClass="register-field-icon"/>
                            <PasswordField fx:id="registerConfirm"
                                           HBox.hgrow="ALWAYS"
                                           maxWidth="Infinity"
                                           promptText="Re-enter password"/>
                        </HBox>
                    </VBox>
                </VBox>

                <Button text="Register"
                        styleClass="register-primary-button"
                        maxWidth="Infinity"
                        onAction="#registerUser"/>

                <Button text="Back to Login"
                        styleClass="register-back-link"
                        maxWidth="Infinity"
                        onAction="#showLogin"/>
            </VBox>
        </HBox>
    </children>
</StackPane>
