<StackPane fx:controller="com.example.onlinemcqexam.ExamController"
           prefHeight="700.0" prefWidth="1040.0"
           xmlns:fx="http://javafx.com/fxml/1"
           xmlns="http://javafx.com/javafx/17.0.6">
    <children>
        <!-- Student Login -->
      
        <!-- =========================================================
     STUDENT LOGIN PAGE
============================================================ -->
<StackPane fx:id="loginPane"
        visible="true" managed="true"
        styleClass="root login-root"
           xmlns:fx="http://javafx.com/fxml">

    <VBox alignment="CENTER" spacing="18" styleClass="login-layout">

        <!-- APP TITLE -->
        <VBox alignment="CENTER" spacing="6">
            <Label text="Exam Portal" styleClass="title login-app-title"/>
        </VBox>

        <!-- LOGIN CARD -->
          <VBox spacing="14" alignment="CENTER"
              styleClass="card"
              prefWidth="380"
              maxWidth="380">

            <Label text="Online MCQ Exam" styleClass="section-title login-subtitle"/>
            <Label text="Log in to continue" styleClass="muted"/>

            <!-- USERNAME -->
            <VBox spacing="6" maxWidth="Infinity" alignment="CENTER_LEFT">
                <Label text="USERNAME" styleClass="field-label"/>
                <TextField fx:id="loginUsername"
                           maxWidth="Infinity"
                           promptText="Enter your student ID"/>
            </VBox>

            <!-- PASSWORD -->
            <VBox spacing="6" maxWidth="Infinity" alignment="CENTER_LEFT">
                <HBox alignment="CENTER_LEFT" maxWidth="Infinity">
                    <Label text="PASSWORD" styleClass="field-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label text="Forgot?" styleClass="muted forgot"/>
                </HBox>

                <PasswordField fx:id="loginPassword" maxWidth="Infinity"/>
            </VBox>

            <!-- LOGIN BUTTON -->
            <Button text="Log In"
                    styleClass="primary-button"
                    maxWidth="Infinity"
                    onAction="#loginUser"/>

                <!-- REGISTER -->
                <HBox alignment="CENTER" spacing="6">
                <Label text="New here?" styleClass="muted"/>
                <Label text="Create Account" styleClass="link-highlight" onMouseClicked="#showRegister"/>
                </HBox>

            <!-- TEACHER LOGIN -->
            <Button text="Teacher Login"
                    styleClass="secondary-button teacher-login-button"
                    maxWidth="Infinity"
                    onAction="#showTeacherLogin"/>

            <!-- STATUS -->
            <Label fx:id="loginMessageLabel" styleClass="error-text"/>

        </VBox>

    </VBox>

</StackPane>

        <!-- Student Register -->
       <!-- =========================================================
     REGISTER PAGE
============================================================ -->
<StackPane fx:id="registerPane"
           visible="false" managed="false"
           styleClass="root register-root"
           xmlns:fx="http://javafx.com/fxml">

    <children>
        <Region styleClass="register-ambient-glow"/>

        <HBox alignment="CENTER" spacing="44" styleClass="register-layout">
            <VBox prefWidth="360" maxWidth="420" spacing="20" styleClass="register-info-panel">
                <VBox spacing="8" styleClass="register-info-block">
                    <FontIcon iconLiteral="fas-shield-alt" styleClass="register-info-icon"/>
                    <Label text="Secure Assessment" styleClass="register-info-title"/>
                    <Label text="Encrypted student sessions and protected exam submissions keep every attempt reliable and safe."
                           styleClass="register-info-text" wrapText="true"/>
                </VBox>

                <VBox spacing="8" styleClass="register-info-block">
                    <FontIcon iconLiteral="fas-chart-line" styleClass="register-info-icon"/>
                    <Label text="Real-time Analytics" styleClass="register-info-title"/>
                    <Label text="Track exam progress, completion insights, and leaderboard movement the moment students finish."
                           styleClass="register-info-text" wrapText="true"/>
                </VBox>
            </VBox>

            <VBox prefWidth="430" maxWidth="430" spacing="16" styleClass="register-card">
                <StackPane prefWidth="54" prefHeight="54" styleClass="register-badge">
                    <FontIcon iconLiteral="fas-user-shield" styleClass="register-badge-icon"/>
                </StackPane>

                <VBox spacing="4" alignment="CENTER_LEFT">
                    <Label text="Create Account" styleClass="register-title"/>
                    <Label text="Register to take exams" styleClass="register-subtitle"/>
                </VBox>

                <HBox fx:id="registerErrorBanner" spacing="8" alignment="CENTER_LEFT" styleClass="register-error-banner" visible="false" managed="false">
                    <FontIcon iconLiteral="fas-exclamation-triangle" styleClass="register-error-icon"/>
                    <Label fx:id="registerMessageLabel" styleClass="register-error-text" wrapText="true"/>
                </HBox>

                <VBox spacing="12" alignment="CENTER_LEFT">
                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="USERNAME / STUDENT ID" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-user" styleClass="register-field-icon"/>
                            <TextField fx:id="registerUsername"
                                       HBox.hgrow="ALWAYS"
                                       maxWidth="Infinity"
                                       promptText="Enter student ID"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="FULL NAME" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-id-card" styleClass="register-field-icon"/>
                            <TextField fx:id="registerFullName"
                                       HBox.hgrow="ALWAYS"
                                       maxWidth="Infinity"
                                       promptText="Enter full name"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="PASSWORD" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-lock" styleClass="register-field-icon"/>
                            <PasswordField fx:id="registerPassword"
                                           HBox.hgrow="ALWAYS"
                                           maxWidth="Infinity"
                                           promptText="Create password"/>
                        </HBox>
                    </VBox>

                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="CONFIRM PASSWORD" styleClass="register-field-label"/>
                        <HBox alignment="CENTER_LEFT" spacing="10" styleClass="register-input-shell">
                            <FontIcon iconLiteral="fas-check-circle" styleClass="register-field-icon"/>
                            <PasswordField fx:id="registerConfirm"
                                           HBox.hgrow="ALWAYS"
                                           maxWidth="Infinity"
                                           promptText="Re-enter password"/>
                        </HBox>
                    </VBox>
                </VBox>

                <Button text="Register"
                        styleClass="register-primary-button"
                        maxWidth="Infinity"
                        onAction="#registerUser"/>

                <Button text="Back to Login"
                        styleClass="register-back-link"
                        maxWidth="Infinity"
                        onAction="#showLogin"/>
            </VBox>
        </HBox>
    </children>

</StackPane>
        
        <!-- =========================================================
     STUDENT DASHBOARD PAGE — STITCH STYLE (FINAL)
============================================================ -->
<BorderPane fx:id="studentDashboardPane"
            visible="false" managed="false"
            styleClass="dashboard-root">

    <left>
        <VBox prefWidth="250" spacing="12" styleClass="dash-sidebar">
            <HBox spacing="12" alignment="CENTER_LEFT" styleClass="dash-profile-block">
                <StackPane styleClass="dash-avatar-circle">
                    <Label text="AS" styleClass="dash-avatar-initials"/>
                </StackPane>
                <VBox spacing="2">
                    <Label text="Alex Student" styleClass="dash-profile-name"/>
                    <Label text="Semester Candidate" styleClass="dash-profile-subtitle"/>
                </VBox>
            </HBox>

            <Button text="Dashboard" onAction="#showStudentDashboard" styleClass="dash-nav-button dash-nav-active">
                <graphic>
                    <FontIcon iconLiteral="fas-th-large" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="Available Exams" onAction="#showAvailableExams" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="far-question-circle" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="Scheduled Exams" onAction="#showScheduledExams" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="far-calendar-alt" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="My Exams" onAction="#showExamHistory" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="far-edit" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="Leaderboard" onAction="#showLeaderboard" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="fas-signal" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="Discussion" onAction="#showDiscussion" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="far-comment-alt" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="Messaging" onAction="#showMessaging" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="fas-comment-dots" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>

            <Region VBox.vgrow="ALWAYS"/>

            <Button text="Settings" onAction="#showSettings" styleClass="dash-nav-button">
                <graphic>
                    <FontIcon iconLiteral="fas-cog" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
            <Button text="Logout" onAction="#handleLogout" styleClass="dash-nav-button dash-nav-danger">
                <graphic>
                    <FontIcon iconLiteral="fas-sign-out-alt" styleClass="dash-nav-icon"/>
                </graphic>
            </Button>
        </VBox>
    </left>

    <center>
        <VBox spacing="22" styleClass="dash-main-area">
            <HBox alignment="CENTER_LEFT" styleClass="dash-header-row">
                <Label text="Dashboard Overview" styleClass="dash-page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox spacing="10" alignment="CENTER_RIGHT">
                    <Label text="Alerts" styleClass="dash-header-pill"/>
                    <Label text="Profile" styleClass="dash-header-pill"/>
                </HBox>
            </HBox>

            <HBox spacing="16" styleClass="dash-stat-row">
                <StackPane HBox.hgrow="ALWAYS" styleClass="dash-stat-card">
                    <Region styleClass="dash-stat-shine" StackPane.alignment="TOP_RIGHT"/>
                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Upcoming Exams" styleClass="dash-stat-title"/>
                        <Label fx:id="dashboardUpcomingCountLabel" text="No data available" styleClass="dash-stat-value"/>
                    </VBox>
                </StackPane>

                <StackPane HBox.hgrow="ALWAYS" styleClass="dash-stat-card">
                    <Region styleClass="dash-stat-shine" StackPane.alignment="TOP_RIGHT"/>
                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Completed Exams" styleClass="dash-stat-title"/>
                        <Label fx:id="dashboardCompletedCountLabel" text="No data available" styleClass="dash-stat-value"/>
                    </VBox>
                </StackPane>

                <StackPane HBox.hgrow="ALWAYS" styleClass="dash-stat-card">
                    <Region styleClass="dash-stat-shine" StackPane.alignment="TOP_RIGHT"/>
                    <VBox spacing="6" alignment="CENTER_LEFT">
                        <Label text="Current Rank" styleClass="dash-stat-title"/>
                        <Label fx:id="dashboardRankLabel" text="No data available" styleClass="dash-stat-value"/>
                    </VBox>
                </StackPane>
            </HBox>

            <HBox spacing="18" VBox.vgrow="ALWAYS">
                <VBox spacing="18" HBox.hgrow="ALWAYS">
                    <VBox spacing="16" styleClass="dash-next-exam-card" VBox.vgrow="ALWAYS">
                        <Label text="Next Scheduled Exam" styleClass="dash-card-label"/>
                        <Label fx:id="dashboardNextExamTitleLabel" text="No data available" styleClass="dash-next-exam-title" wrapText="true"/>
                        <Label fx:id="dashboardNextExamStatusLabel" text="No data available" styleClass="dash-status-badge"/>

                        <HBox spacing="12">
                            <VBox spacing="4" styleClass="dash-meta-box" HBox.hgrow="ALWAYS">
                                <Label text="DATE" styleClass="dash-meta-label"/>
                                <Label fx:id="dashboardNextExamDateValueLabel" text="No data available" styleClass="dash-meta-value"/>
                            </VBox>
                            <VBox spacing="4" styleClass="dash-meta-box" HBox.hgrow="ALWAYS">
                                <Label text="TIME" styleClass="dash-meta-label"/>
                                <Label fx:id="dashboardNextExamTimeValueLabel" text="No data available" styleClass="dash-meta-value"/>
                            </VBox>
                        </HBox>

                        <Button text="Start Exam" styleClass="dash-primary-button" maxWidth="Infinity"/>
                    </VBox>

                    <HBox spacing="14" alignment="CENTER_LEFT" styleClass="dash-support-card">
                        <StackPane styleClass="dash-support-icon-box">
                            <Label text="?" styleClass="dash-support-icon"/>
                        </StackPane>
                        <VBox spacing="5" HBox.hgrow="ALWAYS">
                            <Label text="Need support?" styleClass="dash-support-title"/>
                            <Label text="Connect with your tutor for guidance, exam doubts, and quick help before your session starts."
                                   wrapText="true"
                                   styleClass="dash-support-desc"/>
                        </VBox>
                        <Button text="Contact Tutor" styleClass="dash-neutral-button"/>
                    </HBox>
                </VBox>

                <VBox prefWidth="310" spacing="12" styleClass="dash-right-column">
                    <Label text="Upcoming Exams" styleClass="dash-card-label"/>

                    <Label text="Live Feed" styleClass="dash-card-label"/>
                    <ListView fx:id="dashboardUpcomingExamList" prefHeight="220" styleClass="dash-upcoming-list"/>
                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>

    
           
                        
                   

