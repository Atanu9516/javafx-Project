                            <StackPane styleClass="progress-summary-icon-wrap">
                                <Label text="~" styleClass="progress-summary-icon"/>
                            </StackPane>
                            <VBox spacing="2" HBox.hgrow="ALWAYS">
                                <Label text="Improvement Area" styleClass="progress-summary-title"/>
                                <Label fx:id="improvementAreaLabel" text="No data available" styleClass="progress-summary-value"/>
                                <Label fx:id="improvementAreaMessageLabel" text="Needs improvement and more practice" styleClass="progress-summary-desc" wrapText="true"/>
                            </VBox>
                        </HBox>
                    </HBox>
                </VBox>

                <VBox prefWidth="360" spacing="12" styleClass="progress-history-panel">
                    <HBox alignment="CENTER_LEFT">
                        <Label text="Exam History" styleClass="progress-card-title"/>
